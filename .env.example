# ───────── Nexus Client Portal — copy to `.env` and replace EVERY secret ─────────
# Generate strong values with:  openssl rand -base64 33

# Data stores (internal network only)
POSTGRES_OWNER_PASSWORD=change-me-owner
POSTGRES_APP_PASSWORD=change-me-app
REDIS_PASSWORD=change-me-redis

# API
ENVIRONMENT=production          # production | development
PUBLIC_WEB_ORIGIN=http://localhost:3000
PUBLIC_WS_URL=ws://localhost:8000
TRUSTED_PROXIES=false           # true ONLY behind Envoy/WAF that overwrites X-Forwarded-For
# JWT/report-signing/AES/HMAC keys are generated into the `keys` volume on first start.
# For external secret managers set JWT_PRIVATE_KEY, JWT_PUBLIC_KEY, REPORT_SIGNING_KEY,
# DATA_ENCRYPTION_KEY (base64, 32 bytes) and WEBHOOK_SECRET directly (see backend/app/core/config.py).

# Security policy / ops (all optional)
# MFA_REQUIRED_ROLES=["owner"]   # these roles must enrol TOTP before using the console
# METRICS_TOKEN=                    # enables GET /metrics (Prometheus) behind this bearer token

# Answer gate (Consensus + ContextRAG). /ask answers 503 until both are set. See docs/INTEGRATION.md
# CONSENSUS_URL=http://consensus:3000
# CONSENSUS_ASSERTION_SECRET=      # >= 32 chars, shared with MultiAgent_Consensus (PORTAL_ASSERTION_SECRET)

# Web
COOKIE_SECURE=false             # set true when served over HTTPS

# Demo mode (disable all three in real deployments)
SEED_ON_START=true
SEED_DEMO_PASSWORD=ChangeMe-Nexus-Demo-2025!
TELEMETRY_SIMULATOR=true
