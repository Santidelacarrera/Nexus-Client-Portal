new file mode 100644
index 0000000..16cddf9
--- /dev/null
+++ b/orchestrator/src/answer_gate/assertion.ts
@@ -0,0 +1,69 @@
+import { createHash, createHmac, timingSafeEqual } from 'crypto';
+import { canonicalJson } from '../../../agents/protocol';
+
+/**
+ * Aserción de servicio portal → orquestador. Es lo único que establece el tenant de la petición: el cuerpo NO puede
+ * declararlo. Formato: `base64url(payload).base64url(HMAC-SHA256(secret, base64url(payload)))`.
+ *
+ * `bsha` enlaza la aserción con el cuerpo exacto (JSON canónico): un intermediario no puede reutilizar una aserción
+ * válida con otra pregunta. `jti` de un solo uso evita la repetición dentro de la ventana de validez.
+ */
+export interface AssertionPayload {
+  iss: 'nexus-portal';
+  aud: 'multiagent-consensus';
+  tid: string;
+  sub: string;
+  rid: string;
+  jti: string;
+  iat: number;
+  exp: number;
+  bsha: string;
+}
+
+export class AssertionError extends Error {}
+
+const b64u = (b: Buffer): string => b.toString('base64url');
+export const bodyHash = (body: unknown): string => createHash('sha256').update(canonicalJson(body)).digest('hex');
+
+export function signAssertion(payload: AssertionPayload, secret: string): string {
+  const p = b64u(Buffer.from(JSON.stringify(payload)));
+  return `${p}.${b64u(createHmac('sha256', secret).update(p).digest())}`;
+}
+
+/** Caché de `jti` ya vistos (instancia única; en multi-réplica, sustituir por Redis SET NX EX). */
+export class ReplayCache {
+  private seen = new Map<string, number>();
+  /** true la primera vez que se ve el jti. */
+  claim(jti: string, expSeconds: number, nowSeconds: number): boolean {
+    for (const [k, exp] of this.seen) if (exp < nowSeconds) this.seen.delete(k);
+    if (this.seen.has(jti)) return false;
+    this.seen.set(jti, expSeconds);
+    return true;
+  }
+}
+
+export function verifyAssertion(header: string | undefined, body: unknown, secret: string, maxAgeS: number, replay: ReplayCache, now = Date.now() / 1000): AssertionPayload {
+  if (!header) throw new AssertionError('aserción ausente');
+  const [p, sig, ...rest] = header.split('.');
+  if (!p || !sig || rest.length) throw new AssertionError('aserción malformada');
+  const expected = createHmac('sha256', secret).update(p).digest();
+  const given = Buffer.from(sig, 'base64url');
+  if (given.length !== expected.length || !timingSafeEqual(given, expected)) throw new AssertionError('firma inválida');
+  let payload: AssertionPayload;
+  try {
+    payload = JSON.parse(Buffer.from(p, 'base64url').toString('utf8'));
+  } catch {
+    throw new AssertionError('payload ilegible');
+  }
+  if (payload.iss !== 'nexus-portal' || payload.aud !== 'multiagent-consensus') throw new AssertionError('emisor o audiencia inválidos');
+  for (const k of ['tid', 'sub', 'rid', 'jti', 'bsha'] as const) if (typeof payload[k] !== 'string' || !payload[k]) throw new AssertionError(`falta ${k}`);
+  if (!Number.isFinite(payload.iat) || !Number.isFinite(payload.exp)) throw new AssertionError('tiempos inválidos');
+  if (payload.exp < now) throw new AssertionError('aserción expirada');
+  if (payload.iat > now + 30) throw new AssertionError('aserción emitida en el futuro');
+  if (payload.exp - payload.iat > maxAgeS) throw new AssertionError('vida de aserción excesiva');
+  const want = Buffer.from(bodyHash(body));
+  const have = Buffer.from(payload.bsha);
+  if (want.length !== have.length || !timingSafeEqual(want, have)) throw new AssertionError('el cuerpo no coincide con la aserción');
+  if (!replay.claim(payload.jti, payload.exp, now)) throw new AssertionError('aserción ya utilizada');
+  return payload;
+}
