+/** Utilidades léxicas (es/en) compartidas por los agentes. Deterministas y sin dependencias. */
+const STOP = new Set(
+  ('a al algo ante con contra cual cuales cuando de del desde donde durante e el ella ellas ellos en entre era es esa ese eso esta este esto estos ' +
+    'fue ha hay la las le les lo los mas me mi muy no nos o para pero por que se si sin sobre su sus te tu un una uno unos y ya ' +
+    'the a an and are as at be by for from has have in is it its of on or that the to was were will with which what how much many ' +
+    'cuanto cuanta cuantos cuantas como cual quien segun tiempo').split(/\s+/),
+);
+
+export const stripAccents = (s: string): string => s.normalize('NFD').replace(/[̀-ͯ]/g, '');
+
+/** Token normalizado: minúsculas, sin acentos y con un stemming mínimo de plurales. */
+function stem(t: string): string {
+  if (t.length > 4 && t.endsWith('es')) return t.slice(0, -2);
+  if (t.length > 3 && t.endsWith('s')) return t.slice(0, -1);
+  return t;
+}
+
+export function tokens(text: string): string[] {
+  return (stripAccents(text.toLowerCase()).match(/[a-z0-9]+(?:[.,][0-9]+)?/g) ?? []).map(stem);
+}
+
+export const contentTokens = (text: string): string[] => tokens(text).filter((t) => t.length > 1 && !STOP.has(t));
+
+export function stripCitations(text: string): string {
+  return text.replace(/\[\d+\]/g, '').replace(/\s+/g, ' ').trim();
+}
+
+export function citations(text: string): number[] {
+  return [...text.matchAll(/\[(\d+)\]/g)].map((m) => Number(m[1]));
+}
+
+export function sentences(text: string): string[] {
+  return text
+    .split(/(?<=[.!?])\s+|\n+/)
+    .map((s) => stripCitations(s).replace(/^[-*•\d.)\s]+/, '').trim())
+    .filter((s) => contentTokens(s).length >= 2);
+}
+
+export const numbersIn = (text: string): string[] => (text.match(/\d+(?:[.,]\d+)?/g) ?? []).map((n) => n.replace(',', '.'));
+
+const NEGATION = /\b(no|not|never|nunca|jam[aá]s|sin|ning[uú]n|ninguna|nadie|cannot|can't|isn't|aren't|don't|doesn't)\b/i;
+export const hasNegation = (s: string): boolean => NEGATION.test(s);
+
+export function jaccard(a: string[], b: string[]): number {
+  const A = new Set(a);
+  const B = new Set(b);
+  if (A.size === 0 && B.size === 0) return 1;
+  let inter = 0;
+  for (const x of A) if (B.has(x)) inter++;
+  return inter / (A.size + B.size - inter);
+}
+
+export const clamp01 = (n: number): number => Math.max(0, Math.min(1, n));
