@@ -0,0 +1,120 @@
+/**
+ * Contrato `answer-review.v1` entre el portal, este orquestador y ContextRAG.
+ * Todo lo que cruza una frontera se valida en tiempo de ejecución; un campo ausente o inesperado se trata como
+ * fallo (fail-closed), nunca como "mejor esfuerzo".
+ */
+export const CONTRACT = 'answer-review.v1' as const;
+
+export const GATE_AGENT_IDS = ['hallucination_critic', 'tenant_security_auditor', 'coherence_validator'] as const;
+export type GateAgentId = (typeof GATE_AGENT_IDS)[number];
+
+export const SEVERITIES = ['info', 'low', 'medium', 'high', 'critical'] as const;
+export type GateSeverity = (typeof SEVERITIES)[number];
+export const SEVERITY_RANK: Record<GateSeverity, number> = { info: 0, low: 1, medium: 2, high: 3, critical: 4 };
+export const isBlocking = (s: GateSeverity): boolean => SEVERITY_RANK[s] >= SEVERITY_RANK.high;
+
+/** Fragmento recuperado por ContextRAG (ya con claves en camelCase). */
+export interface Fragment {
+  index: number;
+  score: number;
+  docId: string;
+  source: string;
+  section: string;
+  page: number | null;
+  start: number;
+  end: number;
+  text: string;
+}
+
+export interface RetrievalResult {
+  status: 'ok' | 'no_results';
+  tenantId: string;
+  query: string;
+  fragments: Fragment[];
+  draftAnswer: string | null;
+  latencyMs: number;
+}
+
+export interface GateFinding {
+  code: string;
+  severity: GateSeverity;
+  detail: string;
+  fragmentIndex?: number;
+}
+
+export interface AgentVerdict {
+  agent: GateAgentId;
+  vote: 'approve' | 'reject';
+  /** 0..1, mayor = más seguro/fiel/coherente. */
+  score: number;
+  findings: GateFinding[];
+  rationale: string;
+}
+
+export interface Reason {
+  code: string;
+  agent: GateAgentId | null;
+  severity: GateSeverity;
+  detail: string;
+}
+
+export interface Source extends Fragment {}
+
+export type Outcome = 'RELEASED' | 'BLOCKED';
+
+export interface AnswerReview {
+  contract: typeof CONTRACT;
+  requestId: string;
+  tenantId: string;
+  question: string;
+  outcome: Outcome;
+  /** Sólo presente si outcome === 'RELEASED'. */
+  answer: string | null;
+  reasons: Reason[];
+  votes: AgentVerdict[];
+  /** Fuentes verificadas por el auditor de tenant (aunque otro agente bloquee la respuesta). */
+  sources: Source[];
+  retrieval: { status: 'ok' | 'no_results' | 'unavailable'; fragments: number; latencyMs: number };
+  timings: { totalMs: number; retrievalMs: number; panelMs: number };
+  /** Un desacuerdo no relacionado con seguridad puede requerir revisión humana. */
+  escalation: boolean;
+}
+
+export interface PanelInput {
+  /** Tenant autenticado de la petición (viene de la aserción firmada, nunca del cuerpo). */
+  tenantId: string;
+  /** Tenant que ContextRAG declara haber servido. Debe coincidir con `tenantId`. */
+  retrievalTenantId: string;
+  /** Identificadores (y alias) de OTROS tenants que no deben aparecer jamás en el contenido. */
+  foreignMarkers: string[];
+  question: string;
+  draftAnswer: string;
+  fragments: Fragment[];
+  topK: number;
+}
+
+export interface GateAgent {
+  readonly id: GateAgentId;
+  review(input: PanelInput): Promise<AgentVerdict> | AgentVerdict;
+}
+
+export class InvalidVerdict extends Error {}
+
+/** Valida estructuralmente un veredicto (un agente bizantino/defectuoso no puede colar formas inesperadas). */
+export function validateVerdict(v: unknown, expected: GateAgentId): AgentVerdict {
+  const o = v as Record<string, unknown> | null;
+  if (!o || typeof o !== 'object') throw new InvalidVerdict('veredicto no es un objeto');
+  if (o.agent !== expected) throw new InvalidVerdict(`identidad inesperada: ${String(o.agent)} (esperado ${expected})`);
+  if (o.vote !== 'approve' && o.vote !== 'reject') throw new InvalidVerdict('voto inválido');
+  if (typeof o.score !== 'number' || !Number.isFinite(o.score) || o.score < 0 || o.score > 1) throw new InvalidVerdict('score fuera de [0,1]');
+  if (typeof o.rationale !== 'string') throw new InvalidVerdict('rationale ausente');
+  if (!Array.isArray(o.findings)) throw new InvalidVerdict('findings ausente');
+  const findings = o.findings.map((f): GateFinding => {
+    const x = f as Record<string, unknown>;
+    if (typeof x?.code !== 'string' || typeof x?.detail !== 'string' || !SEVERITIES.includes(x?.severity as GateSeverity)) {
+      throw new InvalidVerdict('hallazgo inválido');
+    }
+    return { code: x.code, severity: x.severity as GateSeverity, detail: x.detail, ...(typeof x.fragmentIndex === 'number' ? { fragmentIndex: x.fragmentIndex } : {}) };
+  });
+  return { agent: expected, vote: o.vote, score: o.score, findings, rationale: o.rationale };
+}
