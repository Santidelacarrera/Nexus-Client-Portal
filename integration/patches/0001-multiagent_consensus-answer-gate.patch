@@ -0,0 +1,59 @@
+# Answer gate — comité de gobernanza para respuestas RAG
+
+Segundo caso de uso del orquestador (el primero son los PR gates): **decidir si una respuesta de ContextRAG puede
+mostrarse a un cliente**. Es un módulo independiente (`orchestrator/src/answer_gate/`); no toca el debate de PRs.
+
+```
+Portal ──POST /v1/answer-gate/reviews──► Answer gate ──POST /api/v1/retrieve──► ContextRAG ──► PostgreSQL (RLS)
+  X-Nexus-Assertion (HMAC, tenant+body)     │  clave API del tenant (reader)
+                                            ├─ Hallucination Critic ┐
+                                            ├─ Tenant Security Auditor (VETO) ├─► protocolo FAIL-CLOSED ─► RELEASED | BLOCKED
+                                            └─ Coherence Validator ┘
+```
+
+## Protocolo (fail-closed) — `protocol.ts`
+
+1. **Quórum total**: los tres agentes deben emitir un veredicto *válido*. Fallo, timeout, veredicto malformado, agente
+   suplantado o ausente ⇒ `BLOCKED` (`agent_fault:<kind>`). No existe "mayoría de los que respondieron".
+2. **Veto de seguridad**: si el Tenant Security Auditor rechaza ⇒ `BLOCKED`, sin respuesta **ni fuentes**, sin escalado humano.
+3. Un `approve` con hallazgos `high|critical` es incoherente ⇒ `BLOCKED` (`inconsistent_verdict`).
+4. **Unanimidad** para liberar. Cualquier rechazo ⇒ `BLOCKED`. Un desacuerdo puro (unos aprueban, otros rechazan, sin veto ni
+   fallos) marca `escalation: true` (revisión humana).
+
+Antes del panel: ContextRAG caído / sin clave / 403 / timeout / sin contexto / eco de tenant distinto ⇒ `BLOCKED`
+sin contenido (`retrieval_*`, `no_context`, `tenant_mismatch`).
+
+## Agentes (deterministas; punto de extensión: `GateAgent`)
+
+| Agente | Qué comprueba |
+|---|---|
+| `hallucination_critic` | Cada afirmación respaldada por una ventana de 1–3 frases de algún fragmento (mínimo ≥ `GATE_GROUNDING_THRESHOLD`, 0.85) y **todas las cifras** presentes en la evidencia |
+| `tenant_security_auditor` | Eco de tenant; identificadores/alias de **otros** tenants en fragmentos, metadatos o borrador; inyección de prompts; secretos; tarjetas (Luhn)/SSN; exfiltración por markdown; límites |
+| `coherence_validator` | Responde a la pregunta (cobertura de términos), sin autocontradicciones (negación/cifras), citas `[n]` existentes |
+
+Sustituir un agente por un juez NLI/LLM es implementar `GateAgent`; el protocolo valida su salida igual.
+
+## Autenticación del portal — `assertion.ts`
+
+El tenant **solo** viaja en `X-Nexus-Assertion = base64url(payload).base64url(HMAC-SHA256)`; el cuerpo no puede declararlo
+(un campo extra → 400). `payload`: `iss=nexus-portal`, `aud=multiagent-consensus`, `tid`, `sub`, `rid`, `jti` (un solo uso),
+`iat/exp` (≤ `GATE_ASSERTION_MAX_AGE_S`), `bsha` = SHA-256 del cuerpo en JSON canónico. Sin `PORTAL_ASSERTION_SECRET` el
+endpoint responde 503 (cerrado). Multi-réplica: sustituir `ReplayCache` por Redis `SET NX EX`.
+
+## Configuración
+
+| Variable | Descripción |
+|---|---|
+| `PORTAL_ASSERTION_SECRET` | Secreto HMAC compartido con el portal (≥ 32 caracteres en producción) |
+| `RAG_URL` | URL de ContextRAG |
+| `RAG_TENANT_KEYS` / `RAG_TENANT_KEYS_FILE` | JSON `{tenantId: claveAPI}` — claves **reader** de ContextRAG ligadas a cada tenant |
+| `GATE_TENANT_ALIASES(_FILE)` | JSON `{tenantId: [alias…]}`: nombres que no deben aparecer en contenido de otros tenants |
+| `GATE_AGENT_TIMEOUT_MS` (5000) · `GATE_RETRIEVAL_TIMEOUT_MS` (8000) · `GATE_MAX_TOP_K` (10) | Límites |
+
+> Atención: este servicio y ContextRAG leen `DATABASE_URL`/`REDIS_URL`. No exportes los del portal al arrancarlos.
+
+## Contrato de respuesta
+
+`answer-review.v1` (JSON Schema en el repo del portal: `contracts/answer-review.v1.schema.json`). La respuesta incluye
+`outcome`, `answer` (solo si `RELEASED`), `reasons[]`, `votes[]`, `sources[]` (solo si el auditor aprobó), `retrieval`,
+`timings`, `escalation`.
diff --git a/orchestrator/src/answer_gate/agents/coherence_validator.ts b/orchestrator/src/answer_gate/agents/coherence_validator.ts
new file mode 100644
index 0000000..ac9ab14
--- /dev/null
+++ b/orchestrator/src/answer_gate/agents/coherence_validator.ts
@@ -0,0 +1,55 @@
+import { AgentVerdict, GateAgent, GateFinding, PanelInput } from '../contracts';
+import { citations, clamp01, contentTokens, hasNegation, jaccard, numbersIn, sentences } from '../text';
+
+/**
+ * Validador de coherencia: la respuesta debe (1) atender a la pregunta, (2) no contradecirse y (3) citar sólo
+ * fragmentos que existen. No juzga si es VERDAD (eso es del crítico de alucinaciones): juzga si es un texto
+ * sensato y utilizable.
+ */
+export class CoherenceValidator implements GateAgent {
+  readonly id = 'coherence_validator' as const;
+  constructor(private readonly minCoverage = 0.34) {}
+
+  review(input: PanelInput): AgentVerdict {
+    const f: GateFinding[] = [];
+    const draft = input.draftAnswer.trim();
+    if (!draft) f.push({ code: 'empty_answer', severity: 'high', detail: 'Borrador vacío.' });
+    if (draft.length > 4000) f.push({ code: 'overlong_answer', severity: 'medium', detail: 'Borrador excesivamente largo.' });
+
+    const qTerms = [...new Set(contentTokens(input.question).filter((t) => t.length >= 3))];
+    const dTerms = new Set(contentTokens(draft));
+    const coverage = qTerms.length === 0 ? 1 : qTerms.filter((t) => dTerms.has(t)).length / qTerms.length;
+    if (coverage < this.minCoverage) f.push({ code: 'off_topic', severity: 'high', detail: `La respuesta cubre ${(coverage * 100).toFixed(0)}% de los términos de la pregunta.` });
+
+    const valid = new Set(input.fragments.map((fr) => fr.index));
+    for (const n of new Set(citations(draft))) if (!valid.has(n)) f.push({ code: 'dangling_citation', severity: 'high', detail: `Cita [${n}] sin fragmento correspondiente.` });
+
+    const ss = sentences(draft);
+    const seen = new Set<string>();
+    for (const s of ss) {
+      const key = contentTokens(s).join(' ');
+      if (seen.has(key)) f.push({ code: 'duplicate_sentence', severity: 'low', detail: 'Frase repetida.' });
+      seen.add(key);
+    }
+    for (let i = 0; i < ss.length; i++) {
+      for (let j = i + 1; j < ss.length; j++) {
+        if (jaccard(contentTokens(ss[i]), contentTokens(ss[j])) < 0.5) continue;
+        const ni = numbersIn(ss[i]);
+        const nj = numbersIn(ss[j]);
+        const numbersDiffer = ni.length > 0 && nj.length > 0 && ni.join() !== nj.join();
+        if (hasNegation(ss[i]) !== hasNegation(ss[j]) || numbersDiffer) {
+          f.push({ code: 'self_contradiction', severity: 'high', detail: `Frases ${i + 1} y ${j + 1} se contradicen.` });
+        }
+      }
+    }
+
+    const blocking = f.filter((x) => x.severity === 'high' || x.severity === 'critical');
+    return {
+      agent: this.id,
+      vote: blocking.length ? 'reject' : 'approve',
+      score: clamp01(coverage * (blocking.length ? 0.5 : 1)),
+      findings: f,
+      rationale: blocking.length ? `${blocking.length} problema(s) de coherencia.` : 'La respuesta atiende a la pregunta y es internamente consistente.',
+    };
+  }
+}
diff --git a/orchestrator/src/answer_gate/agents/hallucination_critic.ts b/orchestrator/src/answer_gate/agents/hallucination_critic.ts
new file mode 100644
index 0000000..95dba04
--- /dev/null
+++ b/orchestrator/src/answer_gate/agents/hallucination_critic.ts
@@ -0,0 +1,64 @@
+import { AgentVerdict, GateAgent, GateFinding, PanelInput } from '../contracts';
+import { clamp01, contentTokens, numbersIn, sentences, tokens } from '../text';
+
+/**
+ * Crítico de alucinaciones. Cada afirmación del borrador debe estar respaldada por una ventana de 1–3 frases
+ * consecutivas de ALGÚN fragmento; el score del borrador es el MÍNIMO sobre las afirmaciones (una sola afirmación sin
+ * respaldo hunde la respuesta), igual que `verify_attribution` de ContextRAG. Además, todo número de la afirmación
+ * debe aparecer en la evidencia: "7 años" respaldado por un texto que dice "5 años" es una alucinación aunque el
+ * resto de palabras coincida.
+ *
+ * Es un proxy léxico determinista: el punto de extensión para un juez NLI/LLM es `GateAgent`.
+ */
+export class HallucinationCritic implements GateAgent {
+  readonly id = 'hallucination_critic' as const;
+  constructor(private readonly threshold = 0.85) {}
+
+  review(input: PanelInput): AgentVerdict {
+    const windows = input.fragments.flatMap((f) => {
+      const ss = f.text.split(/(?<=[.!?])\s+|\n+/).filter((s) => s.trim());
+      const out: { index: number; text: string }[] = [];
+      for (let i = 0; i < ss.length; i++) for (let n = 1; n <= 3 && i + n <= ss.length; n++) out.push({ index: f.index, text: ss.slice(i, i + n).join(' ') });
+      return out;
+    });
+    const indexed = windows.map((w) => ({ ...w, toks: new Set(tokens(w.text)), nums: new Set(numbersIn(w.text)) }));
+
+    const findings: GateFinding[] = [];
+    const claims = sentences(input.draftAnswer);
+    let worst = 1;
+    for (const claim of claims) {
+      const ct = contentTokens(claim);
+      if (ct.length === 0) continue;
+      let best = 0;
+      let bestWin: (typeof indexed)[number] | undefined;
+      for (const w of indexed) {
+        const support = ct.filter((t) => w.toks.has(t)).length / ct.length;
+        if (support > best) {
+          best = support;
+          bestWin = w;
+        }
+      }
+      worst = Math.min(worst, best);
+      const preview = claim.length > 90 ? `${claim.slice(0, 90)}…` : claim;
+      if (best < this.threshold) {
+        findings.push({ code: 'unsupported_claim', severity: 'high', detail: `Respaldo ${best.toFixed(2)} < ${this.threshold}: "${preview}"`, ...(bestWin ? { fragmentIndex: bestWin.index } : {}) });
+        continue;
+      }
+      const missing = numbersIn(claim).filter((n) => !bestWin!.nums.has(n));
+      if (missing.length > 0) {
+        worst = Math.min(worst, 0.5);
+        findings.push({ code: 'numeric_mismatch', severity: 'high', detail: `Cifra(s) ${missing.join(', ')} ausente(s) de la evidencia: "${preview}"`, fragmentIndex: bestWin!.index });
+      }
+    }
+    if (claims.length === 0) findings.push({ code: 'no_verifiable_claims', severity: 'high', detail: 'El borrador no contiene afirmaciones verificables.' });
+
+    const reject = findings.some((f) => f.severity === 'high' || f.severity === 'critical');
+    return {
+      agent: this.id,
+      vote: reject ? 'reject' : 'approve',
+      score: clamp01(claims.length === 0 ? 0 : worst),
+      findings,
+      rationale: reject ? `${findings.length} problema(s) de respaldo en ${claims.length} afirmación(es).` : `Las ${claims.length} afirmación(es) están respaldadas por la evidencia (mínimo ${worst.toFixed(2)}).`,
+    };
+  }
+}
diff --git a/orchestrator/src/answer_gate/agents/tenant_security_auditor.ts b/orchestrator/src/answer_gate/agents/tenant_security_auditor.ts
new file mode 100644
index 0000000..20ff252
--- /dev/null
+++ b/orchestrator/src/answer_gate/agents/tenant_security_auditor.ts
@@ -0,0 +1,101 @@
+import { AgentVerdict, GateAgent, GateFinding, PanelInput } from '../contracts';
+
+const INJECTION: [RegExp, string][] = [
+  [/ignor(?:a|e|ar)\s+(?:todas?\s+)?(?:las\s+)?instrucciones/i, 'ignora instrucciones'],
+  [/ignore\s+(?:all\s+)?(?:previous|prior|above|the)\s+instructions/i, 'ignore previous instructions'],
+  [/disregard\s+(?:the\s+)?(?:previous|above|system)/i, 'disregard previous'],
+  [/you\s+are\s+now\b/i, 'you are now'],
+  [/\bsystem\s+prompt\b/i, 'system prompt'],
+  [/<\/?(?:passage|system|assistant|tool)>/i, 'etiqueta de rol/pasaje'],
+  [/do\s+not\s+(?:tell|reveal\s+to)\s+the\s+user/i, 'ocultar al usuario'],
+];
+
+const SECRETS: [RegExp, string][] = [
+  [/-----BEGIN (?:RSA |EC |OPENSSH |)PRIVATE KEY-----/, 'clave privada'],
+  [/\bAKIA[0-9A-Z]{16}\b/, 'AWS access key'],
+  [/\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b/, 'JWT'],
+  [/\bcrag_[A-Za-z0-9_-]{20,}\b/, 'clave API de ContextRAG'],
+  [/\bgh[pousr]_[A-Za-z0-9]{30,}\b/, 'token de GitHub'],
+  [/\bsk-[A-Za-z0-9]{20,}\b/, 'clave sk-'],
+  [/\b(?:api[_-]?key|secret|passw(?:or)?d)\s*[:=]\s*["']?[^\s"']{8,}/i, 'credencial asignada'],
+];
+
+const luhn = (digits: string): boolean => {
+  let sum = 0;
+  let alt = false;
+  for (let i = digits.length - 1; i >= 0; i--) {
+    let d = Number(digits[i]);
+    if (alt && (d *= 2) > 9) d -= 9;
+    sum += d;
+    alt = !alt;
+  }
+  return sum % 10 === 0;
+};
+
+const escapeRe = (s: string): string => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
+
+/**
+ * Auditor de seguridad de tenant. Tiene VETO: cualquier hallazgo `high|critical` bloquea la respuesta.
+ *
+ *  - eco de tenant: ContextRAG debe declarar haber servido exactamente el tenant autenticado;
+ *  - canarios de otros tenants: ningún identificador/alias de otro tenant puede aparecer en fragmentos ni borrador;
+ *  - inyección de prompts en los fragmentos, o eco de ella en el borrador;
+ *  - secretos/credenciales, tarjetas (Luhn), SSN; marcado de exfiltración (imágenes/enlaces externos) en el borrador.
+ */
+export class TenantSecurityAuditor implements GateAgent {
+  readonly id = 'tenant_security_auditor' as const;
+
+  review(input: PanelInput): AgentVerdict {
+    const f: GateFinding[] = [];
+    if (input.retrievalTenantId !== input.tenantId) {
+      f.push({ code: 'tenant_mismatch', severity: 'critical', detail: 'ContextRAG declara un tenant distinto del autenticado.' });
+    }
+
+    const surfaces: { where: string; text: string; index?: number }[] = [
+      ...input.fragments.flatMap((fr) => [
+        { where: `fragmento ${fr.index}`, text: fr.text, index: fr.index },
+        { where: `metadatos del fragmento ${fr.index}`, text: `${fr.docId} ${fr.source} ${fr.section}`, index: fr.index },
+      ]),
+      { where: 'borrador', text: input.draftAnswer },
+    ];
+
+    for (const marker of input.foreignMarkers) {
+      if (marker.length < 4) continue;
+      const re = new RegExp(`(?<![\\w-])${escapeRe(marker)}(?![\\w-])`, 'i');
+      const hit = surfaces.find((s) => re.test(s.text));
+      if (hit) f.push({ code: 'foreign_tenant_reference', severity: 'critical', detail: `Identificador de otro tenant en ${hit.where}.`, ...(hit.index !== undefined ? { fragmentIndex: hit.index } : {}) });
+    }
+
+    for (const s of surfaces) {
+      const inDraft = s.where === 'borrador';
+      for (const [re, name] of INJECTION) {
+        if (re.test(s.text)) f.push({ code: 'prompt_injection', severity: inDraft ? 'critical' : 'high', detail: `Patrón de inyección (${name}) en ${s.where}.`, ...(s.index !== undefined ? { fragmentIndex: s.index } : {}) });
+      }
+      for (const [re, name] of SECRETS) {
+        if (re.test(s.text)) f.push({ code: 'secret_leak', severity: 'critical', detail: `Posible secreto (${name}) en ${s.where}.`, ...(s.index !== undefined ? { fragmentIndex: s.index } : {}) });
+      }
+      if (inDraft) {
+        for (const m of s.text.matchAll(/\b(?:\d[ -]?){13,19}\b/g)) {
+          const digits = m[0].replace(/\D/g, '');
+          if (digits.length >= 13 && digits.length <= 19 && luhn(digits)) f.push({ code: 'pii_card', severity: 'high', detail: 'Número de tarjeta en el borrador.' });
+        }
+        if (/\b\d{3}-\d{2}-\d{4}\b/.test(s.text)) f.push({ code: 'pii_ssn', severity: 'high', detail: 'SSN en el borrador.' });
+        if (/!\[[^\]]*\]\((?:https?:)?\/\//i.test(s.text)) f.push({ code: 'exfil_markup', severity: 'high', detail: 'Imagen externa en el borrador (canal de exfiltración).' });
+        else if (/\]\(\s*https?:\/\/[^)]+\)/i.test(s.text)) f.push({ code: 'external_link', severity: 'medium', detail: 'Enlace externo en el borrador.' });
+        if (/[\w.+-]+@[\w-]+\.[\w.-]+/.test(s.text)) f.push({ code: 'pii_email', severity: 'medium', detail: 'Correo electrónico en el borrador.' });
+      }
+    }
+
+    if (input.fragments.length > input.topK) f.push({ code: 'fragment_limit', severity: 'high', detail: `ContextRAG devolvió ${input.fragments.length} fragmentos (> top_k ${input.topK}).` });
+    if (input.fragments.some((fr) => fr.text.length > 50_000)) f.push({ code: 'fragment_oversize', severity: 'medium', detail: 'Fragmento de tamaño anómalo.' });
+
+    const blocking = f.filter((x) => x.severity === 'high' || x.severity === 'critical');
+    return {
+      agent: this.id,
+      vote: blocking.length ? 'reject' : 'approve',
+      score: blocking.length ? 0 : f.length ? 0.8 : 1,
+      findings: f,
+      rationale: blocking.length ? `${blocking.length} hallazgo(s) bloqueante(s) de aislamiento/seguridad.` : 'Aislamiento de tenant verificado y sin contenido sensible.',
+    };
+  }
+}
