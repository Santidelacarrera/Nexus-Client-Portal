@@ -0,0 +1,63 @@
+import { Fragment, RetrievalResult } from './contracts';
+import { GateConfig } from './config';
+
+export class RagError extends Error {
+  constructor(
+    readonly code: 'tenant_not_provisioned' | 'unavailable' | 'forbidden' | 'invalid_response' | 'timeout',
+    detail: string,
+  ) {
+    super(detail);
+  }
+}
+
+export interface RagClient {
+  retrieve(tenantId: string, query: string, topK: number, requestId: string): Promise<RetrievalResult>;
+}
+
+const isStr = (v: unknown): v is string => typeof v === 'string';
+const isNum = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v);
+
+/** Valida la respuesta de `POST /api/v1/retrieve` y la traduce a camelCase. Cualquier desviación → invalid_response. */
+export function parseRetrieveResponse(body: unknown): RetrievalResult {
+  const o = body as Record<string, unknown>;
+  if (!o || (o.status !== 'ok' && o.status !== 'no_results') || !isStr(o.tenant_id) || !isStr(o.query) || !Array.isArray(o.fragments) || !isNum(o.latency_ms)) {
+    throw new RagError('invalid_response', 'forma inesperada');
+  }
+  if (o.draft_answer !== null && !isStr(o.draft_answer)) throw new RagError('invalid_response', 'draft_answer inválido');
+  const fragments = o.fragments.map((raw): Fragment => {
+    const f = raw as Record<string, unknown>;
+    if (!isNum(f?.index) || !isNum(f?.score) || !isStr(f?.doc_id) || !isStr(f?.source) || !isStr(f?.section) || !isNum(f?.start) || !isNum(f?.end) || !isStr(f?.text) || !(f?.page === null || isNum(f?.page))) {
+      throw new RagError('invalid_response', 'fragmento inválido');
+    }
+    return { index: f.index, score: f.score, docId: f.doc_id, source: f.source, section: f.section, page: f.page as number | null, start: f.start, end: f.end, text: f.text };
+  });
+  return { status: o.status, tenantId: o.tenant_id, query: o.query, fragments, draftAnswer: (o.draft_answer as string | null) ?? null, latencyMs: o.latency_ms };
+}
+
+/** Cliente HTTP de ContextRAG: la clave API ligada al tenant se elige por el tenant AUTENTICADO de la aserción. */
+export class HttpRagClient implements RagClient {
+  constructor(
+    private readonly cfg: Pick<GateConfig, 'ragUrl' | 'ragTenantKeys' | 'retrievalTimeoutMs'>,
+    private readonly fetchImpl: typeof fetch = fetch,
+  ) {}
+
+  async retrieve(tenantId: string, query: string, topK: number, requestId: string): Promise<RetrievalResult> {
+    const key = Object.prototype.hasOwnProperty.call(this.cfg.ragTenantKeys, tenantId) ? this.cfg.ragTenantKeys[tenantId] : undefined;
+    if (!key) throw new RagError('tenant_not_provisioned', 'sin clave de ContextRAG para el tenant');
+    let res: Response;
+    try {
+      res = await this.fetchImpl(`${this.cfg.ragUrl}/api/v1/retrieve`, {
+        method: 'POST',
+        headers: { 'content-type': 'application/json', 'x-api-key': key, 'x-request-id': requestId },
+        body: JSON.stringify({ tenant_id: tenantId, query, top_k: topK }),
+        signal: AbortSignal.timeout(this.cfg.retrievalTimeoutMs),
+      });
+    } catch (e) {
+      const timeout = e instanceof Error && (e.name === 'TimeoutError' || e.name === 'AbortError');
+      throw new RagError(timeout ? 'timeout' : 'unavailable', timeout ? 'ContextRAG no respondió a tiempo' : 'ContextRAG inalcanzable');
+    }
+    if (res.status === 401 || res.status === 403) throw new RagError('forbidden', `ContextRAG rechazó la petición (${res.status})`);
+    if (!res.ok) throw new RagError('unavailable', `ContextRAG respondió ${res.status}`);
+    return parseRetrieveResponse(await res.json().catch(() => null));
+  }
+}
