diff --git a/orchestrator/src/answer_gate/protocol.ts b/orchestrator/src/answer_gate/protocol.ts
new file mode 100644
index 0000000..3c5f409
--- /dev/null
+++ b/orchestrator/src/answer_gate/protocol.ts
@@ -0,0 +1,71 @@
+import { AgentVerdict, GATE_AGENT_IDS, GateAgentId, Reason, isBlocking, Outcome } from './contracts';
+
+export interface PanelSlot {
+  agent: GateAgentId;
+  verdict?: AgentVerdict;
+  fault?: { kind: 'timeout' | 'invalid' | 'error'; detail: string };
+}
+
+export interface Decision {
+  outcome: Outcome;
+  reasons: Reason[];
+  /** Desacuerdo del comité (unos aprueban, otros rechazan) sin veto de seguridad ni fallos: requiere humano. */
+  escalation: boolean;
+  securityVeto: boolean;
+}
+
+/**
+ * Protocolo de consenso FAIL-CLOSED para liberar una respuesta.
+ *
+ *   1. Quórum total: los TRES agentes deben emitir un veredicto válido. Un fallo, timeout, veredicto malformado o un
+ *      agente ausente bloquea (no hay "mayoría de los que respondieron").
+ *   2. VETO de seguridad: si el Auditor de Tenant rechaza, bloquea sin importar el resto.
+ *   3. Un veredicto que aprueba pero contiene hallazgos high/critical es incoherente consigo mismo → bloquea.
+ *   4. Unanimidad: sólo se libera si los tres aprueban. Cualquier rechazo bloquea.
+ *
+ * Todo lo que no sea explícitamente RELEASED es BLOCKED. Esta función es pura y no lanza.
+ */
+export function decide(slots: PanelSlot[]): Decision {
+  const reasons: Reason[] = [];
+  let faults = 0;
+  let securityVeto = false;
+  let approvals = 0;
+  let rejections = 0;
+
+  for (const id of GATE_AGENT_IDS) {
+    const slot = slots.find((s) => s.agent === id);
+    if (!slot || slot.fault || !slot.verdict) {
+      faults++;
+      reasons.push({ code: `agent_fault:${slot?.fault?.kind ?? 'missing'}`, agent: id, severity: 'critical', detail: slot?.fault?.detail ?? 'El agente no emitió veredicto.' });
+      continue;
+    }
+    const v = slot.verdict;
+    const blocking = v.findings.filter((f) => isBlocking(f.severity));
+    if (v.vote === 'approve' && blocking.length > 0) {
+      rejections++;
+      reasons.push({ code: 'inconsistent_verdict', agent: id, severity: 'critical', detail: 'Aprueba pese a hallazgos de severidad alta/crítica.' });
+      if (id === 'tenant_security_auditor') securityVeto = true;
+      continue;
+    }
+    if (v.vote === 'approve') {
+      approvals++;
+      continue;
+    }
+    rejections++;
+    if (id === 'tenant_security_auditor') {
+      securityVeto = true;
+      reasons.push({ code: 'tenant_security_veto', agent: id, severity: 'critical', detail: v.rationale });
+    } else {
+      reasons.push({ code: 'agent_rejected', agent: id, severity: 'high', detail: v.rationale });
+    }
+    for (const f of blocking) reasons.push({ code: f.code, agent: id, severity: f.severity, detail: f.detail });
+  }
+
+  const released = faults === 0 && rejections === 0 && approvals === GATE_AGENT_IDS.length;
+  return {
+    outcome: released ? 'RELEASED' : 'BLOCKED',
+    reasons,
+    escalation: !released && !securityVeto && faults === 0 && approvals > 0 && rejections > 0,
+    securityVeto,
+  };
+}
