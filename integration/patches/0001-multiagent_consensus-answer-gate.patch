+import { readFileSync } from 'fs';
+
+export interface GateConfig {
+  /** Secreto HMAC compartido con el portal. Sin él, el gate está deshabilitado (503). */
+  assertionSecret?: string;
+  ragUrl: string;
+  /** tenantId → clave API de ContextRAG ligada a ese tenant. */
+  ragTenantKeys: Record<string, string>;
+  /** tenantId → alias adicionales que no deben aparecer en el contenido de otros tenants. */
+  tenantAliases: Record<string, string[]>;
+  agentTimeoutMs: number;
+  retrievalTimeoutMs: number;
+  maxTopK: number;
+  groundingThreshold: number;
+  /** Tolerancia de reloj y vida máxima de una aserción (s). */
+  assertionMaxAgeS: number;
+}
+
+const num = (v: string | undefined, d: number): number => {
+  if (v === undefined || v === '') return d;
+  const n = Number(v);
+  if (!Number.isFinite(n) || n <= 0) throw new Error(`valor numérico inválido: ${v}`);
+  return n;
+};
+
+function json<T>(raw: string | undefined, file: string | undefined, name: string): T | undefined {
+  const text = raw || (file ? readFileSync(file, 'utf8') : undefined);
+  if (!text) return undefined;
+  try {
+    return JSON.parse(text) as T;
+  } catch {
+    throw new Error(`${name} no es JSON válido`);
+  }
+}
+
+export function loadGateConfig(env: Record<string, string | undefined> = process.env, overrides: Partial<GateConfig> = {}): GateConfig {
+  const cfg: GateConfig = {
+    assertionSecret: env.PORTAL_ASSERTION_SECRET || undefined,
+    ragUrl: (env.RAG_URL ?? 'http://localhost:8000').replace(/\/+$/, ''),
+    ragTenantKeys: json<Record<string, string>>(env.RAG_TENANT_KEYS, env.RAG_TENANT_KEYS_FILE, 'RAG_TENANT_KEYS') ?? {},
+    tenantAliases: json<Record<string, string[]>>(env.GATE_TENANT_ALIASES, env.GATE_TENANT_ALIASES_FILE, 'GATE_TENANT_ALIASES') ?? {},
+    agentTimeoutMs: num(env.GATE_AGENT_TIMEOUT_MS, 5_000),
+    retrievalTimeoutMs: num(env.GATE_RETRIEVAL_TIMEOUT_MS, 8_000),
+    maxTopK: num(env.GATE_MAX_TOP_K, 10),
+    groundingThreshold: num(env.GATE_GROUNDING_THRESHOLD, 0.85),
+    assertionMaxAgeS: num(env.GATE_ASSERTION_MAX_AGE_S, 120),
+  };
+  if (process.env.NODE_ENV === 'production' && cfg.assertionSecret && cfg.assertionSecret.length < 32) {
+    throw new Error('PORTAL_ASSERTION_SECRET debe tener al menos 32 caracteres en producción');
+  }
+  return { ...cfg, ...overrides };
+}
