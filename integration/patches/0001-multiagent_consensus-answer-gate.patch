@@ -0,0 +1,60 @@
+import { BadRequestException, Body, CanActivate, Controller, ExecutionContext, HttpCode, Inject, Injectable, Post, Req, ServiceUnavailableException, UnauthorizedException, UseGuards } from '@nestjs/common';
+import { AssertionError, AssertionPayload, ReplayCache, verifyAssertion } from './assertion';
+import { GateConfig } from './config';
+import { AnswerReview } from './contracts';
+import { AnswerGateService } from './gate_service';
+
+export const GATE_CONFIG = Symbol('GATE_CONFIG');
+export const GATE_SERVICE = Symbol('GATE_SERVICE');
+
+interface GateRequest {
+  headers: Record<string, string | string[] | undefined>;
+  body: unknown;
+  gateAssertion?: AssertionPayload;
+}
+
+/** Autentica al portal por aserción HMAC y fija el tenant de la petición. Sin secreto configurado: 503 (cerrado). */
+@Injectable()
+export class PortalAssertionGuard implements CanActivate {
+  private readonly replay = new ReplayCache();
+  constructor(@Inject(GATE_CONFIG) private readonly cfg: GateConfig) {}
+
+  canActivate(ctx: ExecutionContext): boolean {
+    if (!this.cfg.assertionSecret) throw new ServiceUnavailableException('answer gate deshabilitado: falta PORTAL_ASSERTION_SECRET');
+    const req = ctx.switchToHttp().getRequest<GateRequest>();
+    const h = req.headers['x-nexus-assertion'];
+    try {
+      req.gateAssertion = verifyAssertion(Array.isArray(h) ? h[0] : h, req.body, this.cfg.assertionSecret, this.cfg.assertionMaxAgeS, this.replay);
+    } catch (e) {
+      if (e instanceof AssertionError) throw new UnauthorizedException(e.message);
+      throw e;
+    }
+    return true;
+  }
+}
+
+const ALLOWED_KEYS = new Set(['question', 'topK']);
+
+@Controller('v1/answer-gate')
+@UseGuards(PortalAssertionGuard)
+export class AnswerGateController {
+  constructor(
+    @Inject(GATE_SERVICE) private readonly gate: AnswerGateService,
+    @Inject(GATE_CONFIG) private readonly cfg: GateConfig,
+  ) {}
+
+  @Post('reviews')
+  @HttpCode(200)
+  async review(@Req() req: GateRequest, @Body() body: Record<string, unknown>): Promise<AnswerReview> {
+    const a = req.gateAssertion!;
+    if (!body || typeof body !== 'object' || Array.isArray(body)) throw new BadRequestException('cuerpo inválido');
+    // El tenant sólo puede venir de la aserción firmada: cualquier campo extra (p. ej. tenantId) se rechaza.
+    const extra = Object.keys(body).filter((k) => !ALLOWED_KEYS.has(k));
+    if (extra.length) throw new BadRequestException(`campos no permitidos: ${extra.join(', ')}`);
+    const q = body.question;
+    if (typeof q !== 'string' || q.trim().length < 3 || q.length > 2000) throw new BadRequestException('question debe ser texto de 3 a 2000 caracteres');
+    const topK = body.topK === undefined ? 5 : body.topK;
+    if (!Number.isInteger(topK) || (topK as number) < 1 || (topK as number) > this.cfg.maxTopK) throw new BadRequestException(`topK debe ser un entero entre 1 y ${this.cfg.maxTopK}`);
+    return this.gate.review(q.trim(), topK as number, { tenantId: a.tid, userId: a.sub, requestId: a.rid });
+  }
+}
diff --git a/orchestrator/src/answer_gate/gate_service.ts b/orchestrator/src/answer_gate/gate_service.ts
new file mode 100644
index 0000000..fc679b7
--- /dev/null
+++ b/orchestrator/src/answer_gate/gate_service.ts
@@ -0,0 +1,140 @@
+import { Injectable, Logger } from '@nestjs/common';
+import { AgentVerdict, AnswerReview, CONTRACT, GATE_AGENT_IDS, GateAgent, GateAgentId, InvalidVerdict, PanelInput, Reason, RetrievalResult, validateVerdict } from './contracts';
+import { GateConfig } from './config';
+import { PanelSlot, decide } from './protocol';
+import { RagClient, RagError } from './rag_client';
+import { CoherenceValidator } from './agents/coherence_validator';
+import { HallucinationCritic } from './agents/hallucination_critic';
+import { TenantSecurityAuditor } from './agents/tenant_security_auditor';
+
+export interface GateContext {
+  tenantId: string;
+  userId: string;
+  requestId: string;
+}
+
+export function defaultAgents(cfg: Pick<GateConfig, 'groundingThreshold'>): GateAgent[] {
+  return [new HallucinationCritic(cfg.groundingThreshold), new TenantSecurityAuditor(), new CoherenceValidator()];
+}
+
+/** Ejecuta un agente con timeout; cualquier excepción o veredicto inválido se convierte en un fallo explícito. */
+async function runAgent(agent: GateAgent, input: PanelInput, timeoutMs: number): Promise<PanelSlot> {
+  let timer: NodeJS.Timeout | undefined;
+  try {
+    const verdict = await Promise.race([
+      Promise.resolve().then(() => agent.review(input)),
+      new Promise<never>((_, reject) => {
+        timer = setTimeout(() => reject(Object.assign(new Error('timeout'), { gateTimeout: true })), timeoutMs);
+      }),
+    ]);
+    return { agent: agent.id, verdict: validateVerdict(verdict, agent.id) };
+  } catch (e) {
+    const err = e as Error & { gateTimeout?: boolean };
+    const kind = err.gateTimeout ? 'timeout' : err instanceof InvalidVerdict ? 'invalid' : 'error';
+    return { agent: agent.id, fault: { kind, detail: err.gateTimeout ? `sin respuesta en ${timeoutMs} ms` : kind === 'invalid' ? err.message : 'fallo interno del agente' } };
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+@Injectable()
+export class AnswerGateService {
+  private readonly log = new Logger('AnswerGate');
+
+  constructor(
+    private readonly cfg: GateConfig,
+    private readonly rag: RagClient,
+    private readonly agents: GateAgent[],
+  ) {}
+
+  /** Todos los tenants conocidos distintos del autenticado, más sus alias: los "canarios" de fuga entre tenants. */
+  private foreignMarkers(tenantId: string): string[] {
+    const ids = new Set([...Object.keys(this.cfg.ragTenantKeys), ...Object.keys(this.cfg.tenantAliases)]);
+    ids.delete(tenantId);
+    const markers: string[] = [];
+    for (const id of ids) markers.push(id, ...(this.cfg.tenantAliases[id] ?? []));
+    const own = new Set([tenantId, ...(this.cfg.tenantAliases[tenantId] ?? [])].map((s) => s.toLowerCase()));
+    return markers.filter((m) => !own.has(m.toLowerCase()));
+  }
+
+  async review(question: string, topK: number, ctx: GateContext): Promise<AnswerReview> {
+    const t0 = Date.now();
+    const blocked = (reasons: Reason[], retrieval: AnswerReview['retrieval'], extra: Partial<AnswerReview> = {}): AnswerReview => ({
+      contract: CONTRACT,
+      requestId: ctx.requestId,
+      tenantId: ctx.tenantId,
+      question,
+      outcome: 'BLOCKED',
+      answer: null,
+      reasons,
+      votes: [],
+      sources: [],
+      retrieval,
+      timings: { totalMs: Date.now() - t0, retrievalMs: retrieval.latencyMs, panelMs: 0 },
+      escalation: false,
+      ...extra,
+    });
+
+    // 1) Recuperación. Cualquier fallo → BLOCKED sin contenido (no hay respuesta sin contexto auditable).
+    let r: RetrievalResult;
+    const tr = Date.now();
+    try {
+      r = await this.rag.retrieve(ctx.tenantId, question, topK, ctx.requestId);
+    } catch (e) {
+      const code = e instanceof RagError ? e.code : 'unavailable';
+      this.log.warn(`retrieval failed tenant=${ctx.tenantId} rid=${ctx.requestId} code=${code}`);
+      return blocked([{ code: `retrieval_${code}`, agent: null, severity: 'high', detail: 'No se pudo recuperar contexto autorizado.' }], { status: 'unavailable', fragments: 0, latencyMs: Date.now() - tr });
+    }
+    const retrieval = { status: r.status, fragments: r.fragments.length, latencyMs: r.latencyMs };
+
+    // 2) Aislamiento ANTES de mostrar nada: si el eco de tenant no coincide se descarta todo el contenido.
+    if (r.tenantId !== ctx.tenantId) {
+      this.log.error(`TENANT MISMATCH from retrieval expected=${ctx.tenantId} got=${r.tenantId} rid=${ctx.requestId}`);
+      return blocked([{ code: 'tenant_mismatch', agent: 'tenant_security_auditor', severity: 'critical', detail: 'ContextRAG declaró un tenant distinto del autenticado; contenido descartado.' }], { status: 'ok', fragments: 0, latencyMs: r.latencyMs });
+    }
+    if (r.status === 'no_results' || r.fragments.length === 0 || !r.draftAnswer) {
+      return blocked([{ code: 'no_context', agent: null, severity: 'medium', detail: 'No hay contexto autorizado suficiente para responder.' }], retrieval);
+    }
+
+    // 3) Panel en paralelo (cada agente con su timeout) y protocolo fail-closed.
+    const input: PanelInput = {
+      tenantId: ctx.tenantId,
+      retrievalTenantId: r.tenantId,
+      foreignMarkers: this.foreignMarkers(ctx.tenantId),
+      question,
+      draftAnswer: r.draftAnswer,
+      fragments: r.fragments,
+      topK,
+    };
+    const tp = Date.now();
+    const retrievalMs = tp - tr;
+    const byId = new Map<GateAgentId, GateAgent>(this.agents.map((a) => [a.id, a]));
+    const slots = await Promise.all(
+      GATE_AGENT_IDS.map((id) => {
+        const agent = byId.get(id);
+        return agent ? runAgent(agent, input, this.cfg.agentTimeoutMs) : Promise.resolve<PanelSlot>({ agent: id, fault: { kind: 'error', detail: 'agente no registrado' } });
+      }),
+    );
+    const decision = decide(slots);
+    const votes = slots.flatMap((s) => (s.verdict ? [s.verdict as AgentVerdict] : []));
+    const auditor = slots.find((s) => s.agent === 'tenant_security_auditor')?.verdict;
+    const sourcesOk = auditor?.vote === 'approve' && decision.reasons.every((x) => x.code !== 'inconsistent_verdict' || x.agent !== 'tenant_security_auditor');
+    const released = decision.outcome === 'RELEASED';
+
+    this.log.log(`gate tenant=${ctx.tenantId} rid=${ctx.requestId} outcome=${decision.outcome} reasons=${decision.reasons.map((x) => x.code).join(',') || '-'}`);
+    return {
+      contract: CONTRACT,
+      requestId: ctx.requestId,
+      tenantId: ctx.tenantId,
+      question,
+      outcome: decision.outcome,
+      answer: released ? r.draftAnswer : null,
+      reasons: decision.reasons,
+      votes,
+      sources: sourcesOk ? r.fragments : [],
+      retrieval,
+      timings: { totalMs: Date.now() - t0, retrievalMs, panelMs: Date.now() - tp },
+      escalation: decision.escalation,
+    };
+  }
+}
