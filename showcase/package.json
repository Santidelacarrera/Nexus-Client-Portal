{
  "name": "nexus-showcase",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/static/css/input.css -o src/static/css/app.css --minify",
    "build": "npm run vendor && npm run build:css",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/static/css/input.css -o src/static/css/app.css --watch",
    "lint": "eslint src/static/js scripts tests/js --ext .js,.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "jest",
    "test:a11y": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.1.1",
    "@fontsource-variable/space-grotesk": "5.1.0",
    "dompurify": "3.4.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@babel/core": "7.26.0",
    "@babel/preset-env": "7.26.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/forms": "0.5.9",
    "@tailwindcss/typography": "0.5.15",
    "babel-jest": "29.7.0",
    "eslint": "8.57.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-security": "1.7.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "tailwindcss": "3.4.17"
  }
}
