# ───────── Nexus Showcase — copia a `.env` (ignorado por git). NINGÚN secreto vive en el código. ─────────
ENVIRONMENT=development                     # development | production

# Base de datos (PostgreSQL 16). Dos roles distintos, ambos sin superusuario ni BYPASSRLS (ver scripts/db_roles.sh)
DATABASE_URL=postgresql+asyncpg://showcase_app:CAMBIAME@localhost:5432/showcase
STAFF_DATABASE_URL=postgresql+asyncpg://showcase_staff:CAMBIAME@localhost:5432/showcase

# Sesión: >= 32 caracteres aleatorios.  openssl rand -base64 48
SESSION_SECRET=
COOKIE_SECURE=true                          # false SOLO en desarrollo por http://localhost
ALLOWED_HOSTS=["localhost","127.0.0.1"]     # JSON; en producción, tu dominio
TRUSTED_PROXY=false                         # true SOLO detrás de un proxy que sobrescribe X-Forwarded-For
VISITOR_SESSION_HOURS=24                    # vida de la sesión anónima de visitante
STAFF_SESSION_MINUTES=30                    # vida de la sesión del panel interno
RATELIMIT_STORAGE_URI=memory://             # en varias réplicas: redis://host:6379/0

# Panel interno (opcional). Hash Argon2id:  python scripts/hash_password.py
# (el hash contiene '$': en Docker usa --env-file, no `export` sin comillas simples)
STAFF_USERNAME=
STAFF_PASSWORD_HASH=

# Cumplimiento (Ley 21.719 / GDPR). Mientras estén vacíos, las páginas legales muestran "pendiente de completar".
POLICY_VERSION=2026-10-borrador-1
COMPANY_LEGAL_NAME=Nexus Security SpA
# RUT y domicilio: SOLO internos. Se cargan por entorno y la web NO los muestra (ni en footer, ni en políticas).
COMPANY_TAX_ID=
COMPANY_ADDRESS=
PRIVACY_CONTACT_EMAIL=

# Notificación por correo al administrador (OPCIONAL). Sin SMTP_HOST o ADMIN_EMAIL queda desactivada y la API funciona igual.
# Si el envío falla, el mensaje YA está guardado en la base de datos: solo se registra una advertencia.
# El archivo .env no se sube a git. En Docker (--env-file) no pongas comillas ni comentarios en la misma línea.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
